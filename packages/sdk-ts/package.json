{
  "name": "wezas-africa-toolkit",
  "version": "0.2.0",
  "description": "Client SDK TypeScript officiel et serveur MCP pour Wezas Africa Toolkit (validation téléphone, RIB/IBAN/NUBAN, devises, TVA, pays africains).",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "wezas-africa-toolkit": "bin/cli.mjs",
    "wezas-africa": "bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "node --test tests/client.test.mjs"
  },
  "keywords": [
    "africa",
    "toolkit",
    "mcp",
    "fintech",
    "mobile-money",
    "cfa",
    "xaf",
    "xof",
    "vat",
    "tva"
  ],
  "author": "Benjamin EKIA",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
